+  return {
+    width: 5 + Math.floor(random() * 14),
+    height: 4 + Math.floor(random() * 9),
+    startIndex: dimensions.map((size) => random() * (size + 4) - 2),
+    columnStep: randomStep(),
+    rowStep: randomStep(),
+  };
