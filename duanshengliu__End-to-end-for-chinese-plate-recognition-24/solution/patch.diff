+def main():
+    # 创建VideoCapture对象，参数为摄像头索引号，0表示第一个摄像头
+    cap = cv2.VideoCapture(0)
+
+    while True:
+        # 读取视频帧
+        ret, frame = cap.read()
+
+        # 如果视频帧读取成功
+        if ret:
+            # 显示视频帧
+            cv2.imshow('Camera', frame)
+
+        # 按下Esc键退出循环
+        if cv2.waitKey(1) == 27:
+            break
+
+    # 释放VideoCapture对象和销毁所有窗口
+    cap.release()
+    cv2.destroyAllWindows()
