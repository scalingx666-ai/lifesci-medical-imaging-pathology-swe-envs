+def compute_num_params(model, text=False):
+    tot = int(sum([np.prod(p.shape) for p in model.parameters()]))
+    if text:
+        if tot >= 1e6:
+            return '{:.1f}M'.format(tot / 1e6)
+        else:
+            return '{:.1f}K'.format(tot / 1e3)
+    else:
+        return tot
