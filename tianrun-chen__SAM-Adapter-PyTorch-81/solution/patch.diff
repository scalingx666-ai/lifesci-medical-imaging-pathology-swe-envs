+def make_optimizer(param_list, optimizer_spec, load_sd=False):
+    Optimizer = {
+        'sgd': SGD,
+        'adam': Adam,
+        'adamw': AdamW
+    }[optimizer_spec['name']]
+    optimizer = Optimizer(param_list, **optimizer_spec['args'])
+    if load_sd:
+        optimizer.load_state_dict(optimizer_spec['sd'])
+    return optimizer
