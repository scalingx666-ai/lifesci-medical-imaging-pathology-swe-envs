+namespace
+{
+/// Count hide events received by a widget
+class ctkHideEventCounter : public QObject
+{
+public:
+  bool eventFilter(QObject* object, QEvent* event) override
+  {
+    if (event->type() == QEvent::Hide)
+    {
+      ++this->Count;
+    }
+    return QObject::eventFilter(object, event);
+  }
+  int Count{ 0 };
+};
+} // namespace
